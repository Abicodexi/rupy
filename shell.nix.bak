{ pkgs ? import <nixpkgs> { } }:
let
  overrides = builtins.fromTOML (builtins.readFile ./rust-toolchain.toml);
  libPath = with pkgs; lib.makeLibraryPath [
    wayland
    wayland-protocols
    vulkan-loader
    libxkbcommon
    rustup
    cargo
    rustc
    clang
  ];
in
pkgs.mkShell rec {
  buildInputs = with pkgs; [
    cargo
    lld
    clang
    rustc
    rustfmt
    pre-commit
    rustPackages.clippy
    alsa-lib
    vulkan-loader
    xorg.libXrandr
    xorg.libXcursor
    xorg.libXi
    llvmPackages.bintools
    rustup
  ];

  # not strictly necessary once we do overrides via rust-toolchain, but harmless:

  LD_LIBRARY_PATH = libPath;
  RUSTC_VERSION = overrides.toolchain.channel;
  shellHook = ''
  rustup toolchain install ${RUSTC_VERSION} --profile minimal
  export RUSTUP_TOOLCHAIN=${RUSTC_VERSION}
  rustup override set ${RUSTC_VERSION}
  export RUSTC_VERSION=${RUSTC_VERSION}
  '';
}

